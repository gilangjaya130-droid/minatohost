# Copy these variable names into your hosting provider's private environment settings.
# Never commit real secrets or put the service-role key in frontend files.

PORT=3000
NODE_ENV=production
SESSION_DIR=/data/sessions
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_IN_HOST_DASHBOARD
CORS_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app
